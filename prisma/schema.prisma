generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model questions {
  set_id                 String?
  question_id            String @id
  source                 String?
  year                   String?
  slot                   String?
  section                String?
  topic                  String?
  subtopic               String?
  set_html               String?
  question_html          String?
  question_type          String?
  option_a_html          String?
  option_b_html          String?
  option_c_html          String?
  option_d_html          String?
  option_e_html          String?
  answer                 String?
  explanation_html       String?
  video_explanation_link String?
  
  // 1-to-1 link to its vector
  vector                 QuestionVector?
  questionAttempts       QuestionAttempt[]
  reportedQuestions      ReportedQuestion[]
}

// Vector storage model for embeddings
model QuestionVector {
  id         String   @id @default(uuid())
  // The 1-to-1 relationship
  questionId String   @unique
  question   questions @relation(fields: [questionId], references: [question_id], onDelete: Cascade)
  // The vector from local model (Xenova/all-MiniLM-L6-v2 has 384 dimensions)
  vector     Unsupported("vector(384)")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  testProgress  TestProgress[]
  sessions      Session[]
  questionAttempts QuestionAttempt[]
  userProgress  UserProgress[]
  reportedQuestions ReportedQuestion[]
  profile       UserProfile?
}

model Session {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type            String   // 'MOCK', 'PRACTICE_MODULE', 'MIXED_SESSION', 'BANK', 'DIAGNOSTIC'
  
  // Identifiers for the session (optional based on type)
  year            String?  // MOCK
  slot            String?  // MOCK
  topic           String?  // PRACTICE_MODULE
  subtopic        String?  // PRACTICE_MODULE
  
  // Data
  questionIds     String   @default("[]") // JSON array of questions included in this session
  answers         String   @default("{}") // JSON string of { questionId: answer }
  flagged         String   @default("[]") // JSON string of [questionId]
  
  // Progress & State
  timeRemaining   Int?     // seconds remaining for current section
  currentSection  String?  // current active section
  completed       Boolean  @default(false)
  score           Float?   // Float instead of Int for fractional negative marking
  
  // Results
  correct         Int      @default(0)
  incorrect       Int      @default(0)
  skipped         Int      @default(0)
  totalQuestions  Int      @default(0)
  timeTaken       Int?
  
  aiInsights      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model TestProgress {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year            String
  slot            String
  section         String?  // VARC, DILR, QA
  answers         String   @default("{}") // JSON string of { questionId: answer }
  flagged         String   @default("[]") // JSON string of [questionId]
  timeRemaining   Int?     // seconds remaining for current section
  currentSection  String?  // current active section
  completed       Boolean  @default(false)
  score           Int?
  aiInsights      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // @@unique([userId, year, slot]) - removed for migration
  @@index([userId])
}

model QuestionAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId  String
  question    questions @relation(fields: [questionId], references: [question_id], onDelete: Cascade)
  userAnswer  String
  isCorrect   Boolean
  timeTaken   Int?
  source      String   // 'diagnostic', 'practice', 'mock', 'training', 'bank'
  attemptedAt DateTime @default(now())

  @@index([userId])
  @@index([questionId])
  @@index([userId, questionId])
}

model UserProgress {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  section         String
  topic           String
  subtopic        String
  totalQuestions  Int      @default(0)
  correctCount    Int      @default(0)
  masteryLevel    Float    @default(0.0) // Moving BKT estimate (0.0 to 1.0)
  lastAttemptedAt DateTime?
  updatedAt       DateTime @updatedAt

  @@unique([userId, section, topic, subtopic])
  @@index([userId])
}

model UserProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kakshaScore   Float    @default(0) // Overall score 0-100
  totalAttempts Int      @default(0)
  totalCorrect  Int      @default(0)
  strengths     String   @default("[]") // JSON array of top 3 subtopics
  weaknesses    String   @default("[]") // JSON array of bottom 3 subtopics
  xp            Int      @default(0)
  badges        String   @default("[]") // JSON array of badge names
  aiActionPlan  String?  // Markdown/JSON of the generated AI plan
  
  // Onboarding
  onboardingCompleted Boolean @default(false)
  targetExamYear      String?
  age                 Int?
  selfStrengths       String  @default("[]") // JSON array of user-selected topics
  selfWeaknesses      String  @default("[]") // JSON array of user-selected topics
  
  updatedAt     DateTime @updatedAt
}

model ReportedQuestion {
  id          String   @id @default(cuid())
  questionId  String
  question    questions @relation(fields: [questionId], references: [question_id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason      String
  details     String?
  status      String   @default("PENDING") // PENDING, REVIEWED, RESOLVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([questionId])
  @@index([userId])
}
